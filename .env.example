# Application
APP_NAME=OpsGenie
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (async driver — use postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/opsgenie

# Admin auth (Phase 6) — required on every /admin/* route via the X-API-Key
# header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Password-gated server-rendered admin dashboard (browser UI at /dashboard,
# separate from the X-API-Key-gated JSON admin API above). Unset = login
# always rejects.
DASHBOARD_PASSWORD=

# AI (Phase 5B) — pluggable LLM provider with automatic failover.
# Provider: gemini | groq | anthropic | openrouter | cerebras | github_models | cohere | nvidia
LLM_PROVIDER=gemini
# Comma-separated fallback order, tried in turn if the primary is exhausted/unavailable.
# Empty means no automatic fallback.
LLM_FALLBACKS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Cerebras — free tier: 1M tokens/day, independent quota from the providers
# above. Sign up at https://cloud.cerebras.ai — note: has been observed
# returning 402 Payment Required on every model despite the "no credit card"
# marketing; check the account's Billing tab before relying on this one.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# GitHub Models — free with just a GitHub account, no billing signup at all.
# GITHUB_MODELS_API_KEY is a fine-grained personal access token with the
# "models: read" permission (github.com/settings/tokens).
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Cohere — free trial key: 1,000 calls/month cap (not a daily reset). Sign
# up at dashboard.cohere.com, no credit card needed for a trial key.
COHERE_API_KEY=
COHERE_MODEL=command-r7b-12-2024

# NVIDIA NIM (build.nvidia.com) — free API catalog, sign up there for a key.
# Least independently verified of these providers; confirm the model below
# is actually usable on your account before relying on it.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# WhatsApp (Phase 7/8/9) — inbound webhook + outbound sending + follow-ups.
# TOKEN/PHONE_NUMBER_ID from Meta's Cloud API setup; VERIFY_TOKEN is any
# string you choose and register identically in the Meta app; APP_SECRET is
# the Meta app's own "App Secret" (signs inbound POST bodies).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# NotificationEngine (Phase 10) — the operator's own WhatsApp number, where
# internal ops alerts go ("no data received today", "briefing delivery
# failed"). Distinct from any distributor number. Leave blank to skip these.
FOUNDER_WHATSAPP_NUMBER=

# Scheduler (Phase 11) — one poll job dispatches the 8am briefing, its 9am
# retry, the daily follow-up run, and notification checks, each in every
# company's own timezone. Hours are 0-23 local business time. Set
# SCHEDULER_ENABLED=false for local dev if you don't want background sends.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MINUTES=15
BRIEFING_HOUR=8
BRIEFING_RETRY_HOUR=9
FOLLOWUP_HOUR=10
# Evening Business Summary — a second, separate scheduled WhatsApp send
# (Sales/Margin/Collections/Payments/Net Cash Movement/Priority Actions),
# distinct from the 8am morning briefing. Per-company override via the
# dashboard/admin PATCH (Company.evening_brief_hour).
EVENING_BRIEF_HOUR=20

# Self-serve onboarding — the /onboard page is fully public (no access code).
# Set to false to turn off public signups if the form is ever abused.
# WELCOME_TEMPLATE_NAME is the Meta-approved template pushed when a company's
# subscription activates; WELCOME_TEMPLATE_LANGUAGE must match that template.
# WELCOME_TEMPLATE_HAS_VARIABLE=false when standing in with a variable-less
# template (e.g. Meta's stock "hello_world" sample) while your real one is
# still pending approval.
# WHATSAPP_BUSINESS_DISPLAY_NUMBER is the real dialable number (e.g.
# +919876543210) shown as a "Continue on WhatsApp" link on the onboarding
# success page — distinct from WHATSAPP_PHONE_NUMBER_ID above. Leave blank to
# hide that button.
ONBOARDING_ENABLED=true
WELCOME_TEMPLATE_NAME=
WELCOME_TEMPLATE_LANGUAGE=en_US
WELCOME_TEMPLATE_HAS_VARIABLE=true
WHATSAPP_BUSINESS_DISPLAY_NUMBER=

# V0.2 — invoice PDF delivery to a dealer's WhatsApp (a dealer has almost
# never messaged the distributor's number first, so this must go out as a
# Meta-approved template with a document header component — a separate
# template from WELCOME_TEMPLATE_NAME above, created and submitted for
# approval the same way). Leave blank to skip PDF delivery to dealers
# (invoice creation itself still succeeds) until you've set one up.
INVOICE_DOCUMENT_TEMPLATE_NAME=
INVOICE_DOCUMENT_TEMPLATE_LANGUAGE=en_US

# Per-company Excel data export. EXPORT_LINK_SECRET signs the short-lived
# WhatsApp download link (fails closed — unset means every signed link
# rejects); generate one the same way as ADMIN_API_KEY. PUBLIC_BASE_URL is
# this backend's real dialable URL, used to build the clickable link sent
# back over WhatsApp (the admin API / dashboard downloads work regardless).
EXPORT_LINK_SECRET=
EXPORT_LINK_TTL_MINUTES=30
PUBLIC_BASE_URL=
