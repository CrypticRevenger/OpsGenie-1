# Application
# DEBUG=true here would have Starlette's debug middleware return full
# tracebacks in HTTP responses and SQLAlchemy echo every query (including
# bind params — dealer phones, invoice amounts) into logs, so DEBUG defaults
# safe (false) even in this template, which gets copied wholesale to real
# deployments more often than every value gets reviewed individually.
#
# APP_ENV, unlike DEBUG, is left =development here on purpose, not an
# oversight: app/db/session.py ties NullPool to is_development, and this
# suite's tests hang/fail ("RuntimeError: Event loop is closed") without it —
# pytest-asyncio gives each test its own event loop, and a real connection
# pool hands a later test a connection opened against an earlier, already-
# closed loop. A shared default can't be safe for both "local dev / running
# the test suite" and "a naive copy-paste to Render" at once, and breaking
# the former is the worse failure mode of the two.
#
# ⚠ PRODUCTION DEPLOYMENT (Render or anywhere else): you MUST explicitly set
# APP_ENV=production in that environment's own config, not by relying on
# whatever this file ships — it also flips the dashboard session cookie's
# Secure flag on and switches to real connection pooling.
APP_NAME=OpsGenie
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (async driver — use postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/opsgenie

# Admin auth (Phase 6) — required on every /admin/* route via the X-API-Key
# header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Password-gated server-rendered admin dashboard (browser UI at /dashboard,
# separate from the X-API-Key-gated JSON admin API above). Unset = login
# always rejects.
DASHBOARD_PASSWORD=

# AI (Phase 5B) — pluggable LLM provider with automatic failover.
# Provider: gemini | groq | anthropic | openrouter | github_models | cohere
LLM_PROVIDER=gemini
# Comma-separated fallback order, tried in turn if the primary is exhausted/unavailable.
# Empty means no automatic fallback.
LLM_FALLBACKS=
# Per-provider-call ceiling in seconds — a hung call moves to the next provider
# in the chain instead of blocking (the scheduler holds an advisory lock for the
# duration of a briefing generation call).
LLM_TIMEOUT_SECONDS=30

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GitHub Models — free with just a GitHub account, no billing signup at all.
# GITHUB_MODELS_API_KEY is a fine-grained personal access token with the
# "models: read" permission (github.com/settings/tokens).
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Cohere — free trial key: 1,000 calls/month cap (not a daily reset). Sign
# up at dashboard.cohere.com, no credit card needed for a trial key.
COHERE_API_KEY=
COHERE_MODEL=command-r7b-12-2024

# Free-form assistant tunables (Phase 1 agentic read tools). AGENT_MAX_STEPS
# caps the tool-calling loop per question; AGENT_HISTORY_TURNS caps how many
# prior conversation turns are replayed for context. Both have safe defaults.
AGENT_MAX_STEPS=5
AGENT_HISTORY_TURNS=10

# WhatsApp (Phase 7/8/9) — inbound webhook + outbound sending + follow-ups.
# TOKEN/PHONE_NUMBER_ID from Meta's Cloud API setup; VERIFY_TOKEN is any
# string you choose and register identically in the Meta app; APP_SECRET is
# the Meta app's own "App Secret" (signs inbound POST bodies).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# NotificationEngine (Phase 10) — the operator's own WhatsApp number, where
# internal ops alerts go ("no data received today", "briefing delivery
# failed"). Distinct from any distributor number. Leave blank to skip these.
FOUNDER_WHATSAPP_NUMBER=

# Scheduler (Phase 11) — one poll job dispatches the 8am briefing, its 9am
# retry, the daily follow-up run, and notification checks, each in every
# company's own timezone. Hours are 0-23 local business time. Set
# SCHEDULER_ENABLED=false for local dev if you don't want background sends.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MINUTES=15
BRIEFING_HOUR=8
BRIEFING_RETRY_HOUR=9
FOLLOWUP_HOUR=10
# Evening Business Summary — a second, separate scheduled WhatsApp send
# (Sales/Margin/Collections/Payments/Net Cash Movement/Priority Actions),
# distinct from the 8am morning briefing. Per-company override via the
# dashboard/admin PATCH (Company.evening_brief_hour).
EVENING_BRIEF_HOUR=20

# Self-serve onboarding — the /onboard page is fully public (no access code).
# Set to false to turn off public signups if the form is ever abused.
# WELCOME_TEMPLATE_NAME is the Meta-approved template pushed when a company's
# subscription activates; WELCOME_TEMPLATE_LANGUAGE must match that template.
# WELCOME_TEMPLATE_HAS_VARIABLE=false when standing in with a variable-less
# template (e.g. Meta's stock "hello_world" sample) while your real one is
# still pending approval.
# WHATSAPP_BUSINESS_DISPLAY_NUMBER is the real dialable number (e.g.
# +919876543210) shown as a "Continue on WhatsApp" link on the onboarding
# success page — distinct from WHATSAPP_PHONE_NUMBER_ID above. Leave blank to
# hide that button.
# MARKETING_SITE_URL is the public marketing site's real URL (the Vercel
# deployment, e.g. https://ops-genie-nine.vercel.app/ or a custom domain
# once one's set up) — used by the /onboard wizard's "Back"/"Back to
# homepage" links. Leave blank locally; a bare relative "/" would otherwise
# resolve to Render's OWN copy of the marketing pages instead of sending a
# distributor back to the actual public site.
ONBOARDING_ENABLED=true
WELCOME_TEMPLATE_NAME=
WELCOME_TEMPLATE_LANGUAGE=en_US
WELCOME_TEMPLATE_HAS_VARIABLE=true
WHATSAPP_BUSINESS_DISPLAY_NUMBER=+15556342029
MARKETING_SITE_URL=https://ops-genie-nine.vercel.app/

# V0.2 — invoice PDF delivery to a dealer's WhatsApp (a dealer has almost
# never messaged the distributor's number first, so this must go out as a
# Meta-approved template with a document header component — a separate
# template from WELCOME_TEMPLATE_NAME above, created and submitted for
# approval the same way). Leave blank to skip PDF delivery to dealers
# (invoice creation itself still succeeds) until you've set one up.
INVOICE_DOCUMENT_TEMPLATE_NAME=
INVOICE_DOCUMENT_TEMPLATE_LANGUAGE=en_US

# Marketing broadcast to dealers — same "Meta-approved template" reasoning as
# INVOICE_DOCUMENT_TEMPLATE_NAME above. Leave blank to skip broadcast delivery
# to any dealer outside their own 24h WhatsApp session window until you've
# set one up. MAX_BROADCAST_RECIPIENTS caps how many dealers a single
# broadcast can reach (the send loop is synchronous, inside one webhook
# request) — raise it via this var, not a code change.
BROADCAST_TEMPLATE_NAME=
BROADCAST_TEMPLATE_LANGUAGE=en_US
MAX_BROADCAST_RECIPIENTS=50

# Dealer-direct overdue reminders — same "Meta-approved template" reasoning as
# BROADCAST_TEMPLATE_NAME above. Leave blank to skip direct-to-dealer delivery
# outside that dealer's own 24h WhatsApp session window until you've set one
# up (the existing distributor-facing overdue alert is unaffected either way).
DEALER_REMINDER_TEMPLATE_NAME=
DEALER_REMINDER_TEMPLATE_LANGUAGE=en_US

# Per-company Excel data export. EXPORT_LINK_SECRET signs the short-lived
# WhatsApp download link (fails closed — unset means every signed link
# rejects); generate one the same way as ADMIN_API_KEY. PUBLIC_BASE_URL is
# this backend's real dialable URL, used to build the clickable link sent
# back over WhatsApp (the admin API / dashboard downloads work regardless).
EXPORT_LINK_SECRET=
EXPORT_LINK_TTL_MINUTES=30
PUBLIC_BASE_URL=

# Signs the short-lived capability token the public self-serve onboarding
# routes require (see app/services/onboarding_token.py) — without it, anyone
# holding a company UUID could inject invoices into a real distributor's books
# before activation. Optional: unset, it falls back to EXPORT_LINK_SECRET, so
# no new production value is required. Set it to rotate onboarding tokens
# independently of export links.
ONBOARDING_TOKEN_SECRET=

# Region used to normalise bare local dealer/supplier phone numbers to E.164
# (app/services/phone.py). "IN" treats a 10-digit number as Indian.
DEFAULT_PHONE_REGION=IN
